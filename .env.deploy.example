# =====================================================================
# .env.deploy.example — copy to .env.deploy and fill in.
# =====================================================================
# .env.deploy is gitignored and must never be committed. It is read by
# tools/deploy-cloudflare.js and by scripts/push-github.sh.
#
#   cp .env.deploy.example .env.deploy && chmod 600 .env.deploy
# =====================================================================

# ---- Cloudflare (required to deploy)
# A token with, at minimum:
#   Account · Workers Scripts · Edit
#   Account · D1 · Edit
# Create one at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Optional. Resolved from the token when blank, which is the usual answer.
CLOUDFLARE_ACCOUNT_ID=

# A Worker secret, set by the deploy tool. Leave blank to generate one per
# deployment; set it to keep sessions valid across an account migration.
STOCKRIDGE_JWT_SECRET=

# ---- The administrator seeded into a fresh deployment
STOCKRIDGE_ADMIN_USERNAME=admin
# Leave blank to generate a five-digit PIN and print it once.
STOCKRIDGE_ADMIN_PIN=

# ---- GitHub (only needed to push this repository)
GITHUB_TOKEN=
GITHUB_REPO=https://github.com/10client/stockridge
GITHUB_BRANCH=main

# The name and email that appear on commits made from this machine.
GIT_AUTHOR_NAME=StockRidge
GIT_AUTHOR_EMAIL=deploy@stockridge.local
